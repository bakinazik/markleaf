{
  "manifest_version": 3,
  "name": "Markleaf: Bookmark Manager",
  "description": "Simple and practical bookmark manager.",
  "version": "1.5.1",
  "default_locale": "en",
  "permissions": [
    "bookmarks",
    "tabs",
    "storage",
    "activeTab",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "markleaf@bakinazik",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}